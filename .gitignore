.DS_Store
*.log
node_modules/

# Compiled viewer JS is committed so the static site works after clone.
# Run `npm run build` after editing TypeScript under src/.

# Large media stays local (run `make sync-audio`). Video never enters git.
assets/audio/
assets/video/
*.MOV
*.mov
*.m4a
*.mp4
*.mkv
*.avi
*.flac
*.wav

# Archive starter Yue-opera clips ship with the site (~11MB); full packs stay local.
!assets/audio/*.mp3
# Full-length 新龙门客寨 starter (needed for live piece player).
!assets/audio/longmen-kezhai.m4a

# Short per-character Learn clips ship with the site; raw group batches stay local.
!assets/learn/ziyin-audio/**/*.m4a
assets/learn/ziyin-audio/batches/

# Private Baidu / purchase notes and huge local dumps never enter git
data/corpus/SOURCES.local.md
data/corpus/raw/
**/baidu-yueju/

# Intermediate tsc outputs (browser runtime under scripts/dist/src is tracked)
scripts/dist/scripts/
scripts/dist/tests/

.tmp-fangyan/
