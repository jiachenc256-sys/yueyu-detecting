{"id": "baitu-ji-329", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 329, "start": 7495.8, "end": 7497.7, "durationSec": 1.9, "text": "十六年 三尺磨坊可作证", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
