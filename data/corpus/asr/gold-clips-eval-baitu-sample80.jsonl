{"id": "baitu-ji-277", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 277, "start": 6153.9, "end": 6155.9, "durationSec": 2.0, "text": "孩儿不知本无辜", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
{"id": "baitu-ji-280", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 280, "start": 6187.8, "end": 6202.5, "durationSec": 14.7, "text": "遥想咬脐生身母", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
