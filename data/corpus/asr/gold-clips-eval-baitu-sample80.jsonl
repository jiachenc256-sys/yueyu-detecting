{"id": "baitu-ji-359", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 359, "start": 7942.4, "end": 7958.499, "durationSec": 16.099, "text": "三娘啊 不念为夫念孩儿", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
{"id": "baitu-ji-364", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 364, "start": 7973.7, "end": 8001.0, "durationSec": 27.3, "text": "请三娘凤冠霞帔做夫人", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
