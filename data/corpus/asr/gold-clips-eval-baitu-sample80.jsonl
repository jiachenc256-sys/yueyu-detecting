{"id": "baitu-ji-316", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 316, "start": 6665.3, "end": 6686.4, "durationSec": 21.1, "text": "雪夜快马接妻来", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
