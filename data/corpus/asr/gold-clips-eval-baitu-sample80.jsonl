{"id": "baitu-ji-270", "pieceId": "baitu-ji", "title": "白兔记", "audio": "assets/audio/baitu-ji.m4a", "cueId": 270, "start": 6068.6, "end": 6072.899, "durationSec": 4.299, "text": "善恶不分、是非颠倒岂能饶", "zhStatus": "corrected", "speaker": null, "split": "test", "register": null, "goldOk": true, "rights": "archive-starter", "notes": ""}
