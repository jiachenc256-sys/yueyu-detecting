{
  "pieceId": "longmen-kezhai",
  "language": "en",
  "schemaVersion": "1.0.0",
  "entries": [
    { "id": 1, "text": "[Overture]", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 2, "text": "[Overture]", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 3, "text": "[Overture]", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 4, "text": "[Overture]", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 5, "text": "I want your eyes — you have eyes yet cannot see", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 6, "text": "I want your skin — you have skin yet no shame", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 7, "text": "I want your feet — you have legs yet cannot stand straight", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 8, "text": "I want your life — you are unfit to live in this world", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 9, "text": "Unfit to live in this world", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 10, "text": "This broken door needs fixing again", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 11, "text": "Aiya, aiya", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 12, "text": "A change in the weather is coming", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 13, "text": "Beyond the pass, Dragon Gate — wind locks the rain, ah, wind locks the rain", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 14, "text": "Dust and sand bury all traces of people, ah, traces of people", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 15, "text": "Cliffs on every side, steep among a thousand ridges", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 16, "text": "In the empty dark, the moon hangs; a lone wild goose cries", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 17, "text": "North wind, south wind, whirlwind — they blow upon people", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 18, "text": "Hearts grow anxious, so anxious", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 19, "text": "They blow until people's hearts grow anxious", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 20, "text": "Honored guests, all of you", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 21, "text": "I am Diao Buyu", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 22, "text": "A Tartar", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 23, "text": "Head cook of Dragon Gate Inn", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 24, "text": "This here is Dragon Gate Inn", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 25, "text": "In this desert, near and far", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 26, "text": "For a hundred li around", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 27, "text": "Ours is the only inn", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 28, "text": "Even if I renamed it Dragon Gate Black Inn", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 29, "text": "You'd still have to come in, wouldn't you?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 30, "text": "Isn't that so?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 31, "text": "Besides, who does not know", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 32, "text": "Dragon Gate Pass", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 33, "text": "is the vital frontier town from the capital to the outer regions", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 34, "text": "Who does not know", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 35, "text": "that the proprietress of our Dragon Gate Inn", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 36, "text": "is a peerless beauty, graceful and poised", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 37, "text": "Her name is Jin", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 38, "text": "Xiangyu", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 39, "text": "Which dull fellow", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 40, "text": "is calling in such a greasy way?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 41, "text": "So it is the chiliarch who guards the pass", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 42, "text": "the freeloading Company Commander", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 43, "text": "Hey, Tartar dog", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 44, "text": "Hey, Tartar dog", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 45, "text": "Tartar dog", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 46, "text": "Tartar dog", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 47, "text": "Tatar — not 'Tartar dog'", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 48, "text": "Truly a dull fellow", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 49, "text": "And your proprietress", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 50, "text": "Jin Xiangyu?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 51, "text": "Elder sister has gone to sleep", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 52, "text": "Gone to sleep", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 53, "text": "I see her room still lit bright", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 54, "text": "Could someone still be hiding inside?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 55, "text": "Company Commander, in the dead of night", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 56, "text": "what urgent business brings you to our proprietress?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 57, "text": "Oh — of course there is urgent business", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 58, "text": "In the capital, the court is storm and rain", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 59, "text": "Loyal and treacherous are hard to tell; human hearts leave traces", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 60, "text": "Power presses from every side", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 61, "text": "A game of ten thousand players", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 62, "text": "Blue clouds stained with blood; injustice fills the land", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 63, "text": "Civil factions, military factions, and the eunuch faction", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 64, "text": "stir the realm into unrest", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 65, "text": "Lord Cao of the Eastern Depot has issued a wanted order — it has arrived", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 66, "text": "Aiya, aiya", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 67, "text": "How could our Son of Heaven let rebels run wild?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 68, "text": "Heaven itself knows: rain in drought, sun in flood", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 69, "text": "Right — Heaven is the Son of Heaven's son", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 70, "text": "and the Son of Heaven is Heaven's father", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 71, "text": "In truth Heaven does not know", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 72, "text": "or else how would there be this desert?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 73, "text": "You speak treason", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 74, "text": "As for fugitives — where couldn't they flee?", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 75, "text": "Yet they flee to our", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 76, "text": "desert here", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 77, "text": "A place where even birds leave no droppings", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 78, "text": "A place where even birds leave no droppings", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 79, "text": "Well said, well said", "status": "curated", "source": "archive-editor-2026-08" },
    { "id": 80, "text": "Then I shall go find your proprietress", "status": "curated", "source": "archive-editor-2026-08" }
  ]
}
